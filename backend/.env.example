# Settings for the matching runner (npm run match). Copy this file to
# backend/.env - which git ignores - and fill it in.

# Path to YOUR OWN Firebase admin key: Firebase console > Project settings >
# Service accounts > Generate new private key. Keep the .json OUTSIDE the repo
# and put only its path here; never paste the key itself into a .env, since
# .env files get passed around.
FIREBASE_SERVICE_ACCOUNT=C:/Users/you/keys/ribe-admin.json

# Optional. Without these the runner uses EXPO_PUBLIC_GOOGLE_MAPS_API_KEY and
# EXPO_PUBLIC_FIREBASE_PROJECT_ID from mobile/.env.
# GOOGLE_MAPS_API_KEY=
# FIREBASE_PROJECT_ID=

# Optional. The Servo Saver consumer id for live fuel prices in cost splits;
# without it every split uses an estimated Melbourne median.
# SERVO_SAVER_API_KEY=
