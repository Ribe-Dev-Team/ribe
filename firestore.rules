rules_version = '2';
// A copy of the rules published in the Firebase console (Firestore Database ->
// Rules). Editing this file does NOT deploy it: paste it into the console and
// publish, so the two stay the same.
service cloud.firestore {
  match /databases/{database}/documents {

    match /rideRequests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;

      // Allow soft cancellation (update status)
      allow update: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        resource.data.matchedDriverId == request.auth.uid
      );

      // Allow hard deletion (deleteDoc)
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /rideOffers/{offerId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;

      // Allow soft cancellation (update status)
      allow update: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        resource.data.matchedRiderId == request.auth.uid ||
        isConfirmedRiderLeaving()
      );

      // Allow hard deletion (deleteDoc)
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;

      // A confirmed rider cancelling takes their own seat off the car
      // (cancelConfirmedRequest in mobile/pages/schema/firebaseBookingMethods.ts):
      // exactly one request id comes off `confirmedRequestIds`, it must be one
      // of theirs, cancelled in the same write, and the only other fields they
      // can touch are the offer's status and its timetable - both of which
      // must be what the app would write. Not on a cancelled offer, or while
      // another rider is deciding on the car - the matching runner frees the
      // seat then.
      function isConfirmedRiderLeaving() {
        let before = resource.data.get('confirmedRequestIds', []);
        let after = request.resource.data.get('confirmedRequestIds', []);
        let removed = before.removeAll(after);
        return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['confirmedRequestIds', 'status', 'schedule'])
          && removed.size() == 1
          && after.size() == before.size() - 1
          && get(/databases/$(database)/documents/rideRequests/$(removed[0])).data.userId == request.auth.uid
          && getAfter(/databases/$(database)/documents/rideRequests/$(removed[0])).data.status == 'cancelled'
          && resource.data.status in ['pending', 'confirmed']
          && resource.data.get('pendingRequestId', null) == null
          && statusAfterLeaving(after.size())
          && scheduleAfterLeaving(removed[0], after.size());
      }

      // The same as settledOfferStatus in firebaseBookingMethods.ts: full, or
      // locked with someone still aboard, is 'confirmed'; otherwise 'pending'.
      function statusAfterLeaving(ridersLeft) {
        let done = ridersLeft >= resource.data.seatCapacity
          || (resource.data.get('acceptingMore', true) == false && ridersLeft > 0);
        return (done && request.resource.data.status == 'confirmed')
          || (!done && request.resource.data.status == 'pending');
      }

      // With nobody left, or no timetable to begin with, there is none after.
      // Otherwise only the leaver's stop may come out (the rest unchanged),
      // the driver's own times stay, and it is marked for the runner to re-plan.
      // The stops' order can't be checked here; the app's cards sort them by
      // pickup time instead (middleStops in mobile/services/rideData.ts).
      function scheduleAfterLeaving(leaverId, ridersLeft) {
        let hadOne = 'schedule' in resource.data;
        let hasOne = 'schedule' in request.resource.data;
        return ((!hadOne || ridersLeft == 0) && !hasOne)
          || (hadOne && ridersLeft > 0 && hasOne
              && stopCutOut(resource.data.schedule, request.resource.data.schedule, leaverId));
      }

      function stopCutOut(old, next, leaverId) {
        let cut = old.stops.removeAll(next.stops);
        return next.diff(old).affectedKeys().hasOnly(['stops', 'needsReplan'])
          && next.get('needsReplan', false) == true
          && old.stops.hasAll(next.stops)
          && next.stops.size() == old.stops.size() - cut.size()
          && (cut.size() == 0 || (cut.size() == 1 && cut[0].requestId == leaverId));
      }
    }

    // User profile permissions
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
    // Driver profile permissions
    match /drivers/{driverId} {
      allow read, write: if request.auth != null;
    }
  }
}
